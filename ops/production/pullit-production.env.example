# 이 파일은 키 이름·공개 고정값만 검토하기 위한 템플릿이다.
# 실제 파일명은 pullit-production.env이며 Git에 절대 추가하지 않는다.

DB_USERNAME=pullit_app
DB_PASSWORD=__SECRET__
DB_ROOT_PASSWORD=__SECRET__
PULLIT_DATABASE_NAME=pullit
# 아래 volume은 새 `pullit-portfolio-production` EC2 전용 이름이다.
# 레거시 Pull-it/Yeon 호스트의 volume 이름을 절대로 넣거나 재사용하지 않는다.
PULLIT_DB_VOLUME=pullit-prod-db-data
PULLIT_REDIS_VOLUME=pullit-prod-redis-data
PULLIT_RABBITMQ_VOLUME=pullit-prod-rabbitmq-data
RABBITMQ_DEFAULT_USER=pullit_app
RABBITMQ_DEFAULT_PASS=__SECRET__
JWT_SECRET_KEY=__SECRET__
KAKAO_REST_API_KEY=__SECRET__
KAKAO_CLIENT_SECRET=__SECRET__
KAKAO_REDIRECT_URI=https://portfolio.yeon.world/pull-it/login/oauth2/code/kakao
JWT_REDIRECT_URL_1=https://portfolio.yeon.world/pull-it/login-success
JWT_COOKIE_DOMAIN_1=portfolio.yeon.world
JWT_REFRESH_COOKIE_PATH=/pull-it/auth/refresh
SERVER_SERVLET_SESSION_COOKIE_NAME=PULLIT_OAUTH_SESSION
SERVER_SERVLET_SESSION_COOKIE_PATH=/pull-it
PULLIT_OAUTH2_REDIRECT_URI=https://portfolio.yeon.world/pull-it/login-success
ACCESS_CONTROL_ALLOWED_ORIGIN_1=https://portfolio.yeon.world
GEMINI_API_KEY=__SECRET__
S3_BUCKET_NAME=pullit-portfolio-production-52685a79
S3_REGION=ap-northeast-2
# 운영은 EC2 instance profile의 최소 권한으로 접근한다. 장기 AWS 키를 넣지 않는다.
SENTRY_DSN=__SECRET__
PULLIT_CLOUDFLARE_TUNNEL_TOKEN=__SECRET__
