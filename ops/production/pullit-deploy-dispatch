#!/usr/bin/env bash
# Root-owned dispatcher. The GitHub Actions SSH identity can only invoke this
# program through sudo; it cannot run arbitrary Docker commands on the Pi.
set -euo pipefail

component="${1:-}"
revision="${2:-}"

if [[ ! "$component" =~ ^(backend|frontend|docs)$ ]] || [[ ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo "허용되지 않은 Pull-it 배포 요청입니다." >&2
  exit 64
fi

readonly incoming="/opt/pullit/incoming/$component/$revision"
readonly destination="/opt/pullit/$component"

case "$component" in
  backend)
    required=(docker-compose.prod.yml deploy-production.sh pullit-production.env)
    runtime_files=(docker-compose.prod.yml deploy-production.sh pullit-production.env)
    ;;
  frontend)
    required=(docker-compose.frontend.yml nginx.conf deploy-frontend.sh verify-frontend-bundle.sh dist/index.html)
    runtime_files=(docker-compose.frontend.yml nginx.conf deploy-frontend.sh verify-frontend-bundle.sh)
    ;;
  docs)
    required=(docker-compose.prod.yml deploy-docs.sh pullit-docs-production.env)
    runtime_files=(docker-compose.prod.yml deploy-docs.sh pullit-docs-production.env)
    ;;
esac

for relative_path in "${required[@]}"; do
  if [[ ! -f "$incoming/$relative_path" ]]; then
    echo "배포 산출물에 필수 파일이 없습니다: $relative_path" >&2
    exit 65
  fi
done

install -d -m 750 "$destination"
install -d -m 750 "$destination/revisions"
release="$destination/revisions/$revision"
if [[ ! -d "$release" ]]; then
  install -d -m 750 "$release"
  cp -a "$incoming/." "$release/"
  find "$release" -type d -exec chmod 750 {} +
  find "$release" -type f -exec chmod 640 {} +
  chmod 750 "$release"/*.sh
fi

previous_current=''
if [[ -L "$destination/current" ]]; then
  previous_current="$(readlink -f "$destination/current")"
fi

rollback_directory="$(mktemp -d "$destination/.rollback.XXXXXXXX")"
cleanup() {
  rm -rf "$rollback_directory"
}
trap cleanup EXIT

had_previous_runtime=false
for runtime_file in "${runtime_files[@]}"; do
  if [[ -e "$destination/$runtime_file" ]]; then
    cp -a "$destination/$runtime_file" "$rollback_directory/$runtime_file"
    had_previous_runtime=true
  fi
done

install_runtime_contract() {
  case "$component" in
    backend)
      install -m 600 "$release/pullit-production.env" "$destination/pullit-production.env"
      install -m 640 "$release/docker-compose.prod.yml" "$destination/docker-compose.prod.yml"
      install -m 750 "$release/deploy-production.sh" "$destination/deploy-production.sh"
      ;;
    frontend)
      install -m 640 "$release/docker-compose.frontend.yml" "$destination/docker-compose.frontend.yml"
      install -m 640 "$release/nginx.conf" "$destination/nginx.conf"
      install -m 750 "$release/deploy-frontend.sh" "$destination/deploy-frontend.sh"
      install -m 750 "$release/verify-frontend-bundle.sh" "$destination/verify-frontend-bundle.sh"
      ;;
    docs)
      install -m 600 "$release/pullit-docs-production.env" "$destination/pullit-docs-production.env"
      install -m 640 "$release/docker-compose.prod.yml" "$destination/docker-compose.prod.yml"
      install -m 750 "$release/deploy-docs.sh" "$destination/deploy-docs.sh"
      ;;
  esac
}

run_deploy() {
  case "$component" in
    backend) "$destination/deploy-production.sh" ;;
    frontend) "$destination/deploy-frontend.sh" "$release/dist" "$revision" ;;
    docs) "$destination/deploy-docs.sh" ;;
  esac
}

restore_previous_contract() {
  for runtime_file in "${runtime_files[@]}"; do
    rm -f "$destination/$runtime_file"
    if [[ -e "$rollback_directory/$runtime_file" ]]; then
      cp -a "$rollback_directory/$runtime_file" "$destination/$runtime_file"
    fi
  done

  if [[ -n "$previous_current" ]]; then
    ln -sfn "$previous_current" "$destination/.current-rollback"
    mv -Tf "$destination/.current-rollback" "$destination/current"
  else
    rm -f "$destination/current"
  fi
}

install_runtime_contract

if ! run_deploy; then
  echo "Pull-it $component 배포가 실패했습니다. 이전 runtime 계약으로 복구합니다." >&2
  restore_previous_contract
  if [[ "$had_previous_runtime" = true ]]; then
    if ! run_deploy; then
      echo "이전 Pull-it $component runtime 재기동도 실패했습니다. 즉시 운영자 점검이 필요합니다." >&2
    fi
  fi
  exit 1
fi

ln -sfn "$release" "$destination/.current-next"
mv -Tf "$destination/.current-next" "$destination/current"
echo "Pull-it $component revision $revision 배포를 확정했습니다."
