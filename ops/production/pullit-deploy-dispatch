#!/usr/bin/env bash
# Root-owned dispatcher. CI may submit immutable release data only. Docker
# Compose files and deployment drivers are provisioned by an operator as
# root-owned runtime contracts and are never executed from /opt/pullit/incoming.
set -euo pipefail

component="${1:-}"
revision="${2:-}"

if [[ ! "$component" =~ ^(backend|frontend|docs)$ ]] || [[ ! "$revision" =~ ^[0-9a-f]{40}$ ]]; then
  echo "허용되지 않은 Pull-it 배포 요청입니다." >&2
  exit 64
fi

readonly incoming="/opt/pullit/incoming/$component/$revision"
readonly destination="/opt/pullit/$component"

case "$component" in
  backend)
    required=(pullit-production.env)
    runtime_files=(pullit-production.env)
    ;;
  frontend)
    required=(dist/index.html)
    runtime_files=()
    ;;
  docs)
    required=(pullit-docs-production.env)
    runtime_files=(pullit-docs-production.env)
    ;;
esac

for relative_path in "${required[@]}"; do
  if [[ ! -f "$incoming/$relative_path" ]]; then
    echo "배포 산출물에 필수 파일이 없습니다: $relative_path" >&2
    exit 65
  fi
done

install -d -m 750 "$destination"
install -d -m 750 "$destination/revisions"
release="$destination/revisions/$revision"
if [[ ! -d "$release" ]]; then
  install -d -m 750 "$release"
  cp -a "$incoming/." "$release/"
  find "$release" -type d -exec chmod 750 {} +
  find "$release" -type f -exec chmod 640 {} +
  # 새 배포는 실행 스크립트를 전송하지 않고 root 소유 정적 경로에서만 실행한다.
  # find는 일치 파일이 없어도 성공하므로 환경 파일만 전송한 release도 허용한다.
  find "$release" -maxdepth 1 -type f -name '*.sh' -exec chmod 750 {} +
fi

previous_current=''
if [[ -L "$destination/current" ]]; then
  previous_current="$(readlink -f "$destination/current")"
fi

rollback_directory="$(mktemp -d "$destination/.rollback.XXXXXXXX")"
cleanup() {
  rm -rf "$rollback_directory"
}
trap cleanup EXIT

had_previous_runtime=false
for runtime_file in "${runtime_files[@]}"; do
  if [[ -e "$destination/$runtime_file" ]]; then
    cp -a "$destination/$runtime_file" "$rollback_directory/$runtime_file"
    had_previous_runtime=true
  fi
done

install_runtime_contract() {
  case "$component" in
    backend)
      validate_backend_env "$release/pullit-production.env"
      install -m 600 "$release/pullit-production.env" "$destination/pullit-production.env"
      ;;
    frontend)
      ;;
    docs)
      validate_docs_env "$release/pullit-docs-production.env"
      install -m 600 "$release/pullit-docs-production.env" "$destination/pullit-docs-production.env"
      ;;
  esac
}

validate_env_file() {
  local env_file="$1"
  shift
  declare -A allowed=()
  local key
  for key in "$@"; do allowed["$key"]=1; done
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]] || {
      echo "허용되지 않은 Pull-it runtime 환경변수 형식입니다." >&2
      exit 65
    }
    key="${BASH_REMATCH[1]}"
    [[ -n "${allowed[$key]:-}" ]] || {
      echo "허용되지 않은 Pull-it runtime 환경변수입니다: $key" >&2
      exit 65
    }
    unset 'allowed[$key]'
  done < "$env_file"
  if (( ${#allowed[@]} != 0 )); then
    echo "Pull-it runtime 환경변수가 누락되었습니다." >&2
    exit 65
  fi
}

validate_backend_env() {
  validate_env_file "$1" \
    PULLIT_BACKEND_IMAGE DB_USERNAME DB_PASSWORD DB_ROOT_PASSWORD \
    PULLIT_DATABASE_NAME RABBITMQ_DEFAULT_USER RABBITMQ_DEFAULT_PASS \
    JWT_SECRET_KEY KAKAO_REST_API_KEY KAKAO_CLIENT_SECRET GEMINI_API_KEY \
    S3_BUCKET_NAME S3_REGION S3_ACCESS_KEY S3_SECRET_KEY MINIO_ROOT_USER \
    MINIO_ROOT_PASSWORD SENTRY_DSN
}

validate_docs_env() {
  validate_env_file "$1" PULLIT_DOCS_IMAGE PULLIT_DOCS_DB_PASSWORD
}

run_deploy() {
  case "$component" in
    backend)
      require_root_owned "$destination/docker-compose.prod.yml" "$destination/deploy-production.sh"
      "$destination/deploy-production.sh"
      ;;
    frontend)
      require_root_owned "$destination/docker-compose.frontend.yml" "$destination/nginx.conf" "$destination/deploy-frontend.sh" "$destination/verify-frontend-bundle.sh"
      "$destination/deploy-frontend.sh" "$release/dist" "$revision"
      ;;
    docs)
      require_root_owned "$destination/docker-compose.prod.yml" "$destination/deploy-docs.sh"
      "$destination/deploy-docs.sh"
      ;;
  esac
}

require_root_owned() {
  local runtime_file
  for runtime_file in "$@"; do
    [[ -f "$runtime_file" && "$(stat -c '%U:%a' "$runtime_file")" =~ ^root:[0-7][0-5][0-5]$ ]] || {
      echo "운영자만 설치할 수 있는 Pull-it runtime 계약이 없거나 안전하지 않습니다: $runtime_file" >&2
      exit 65
    }
  done
}

restore_previous_contract() {
  for runtime_file in "${runtime_files[@]}"; do
    rm -f "$destination/$runtime_file"
    if [[ -e "$rollback_directory/$runtime_file" ]]; then
      cp -a "$rollback_directory/$runtime_file" "$destination/$runtime_file"
    fi
  done

  if [[ -n "$previous_current" ]]; then
    ln -sfn "$previous_current" "$destination/.current-rollback"
    mv -Tf "$destination/.current-rollback" "$destination/current"
  else
    rm -f "$destination/current"
  fi
}

install_runtime_contract

if ! run_deploy; then
  echo "Pull-it $component 배포가 실패했습니다. 이전 runtime 계약으로 복구합니다." >&2
  restore_previous_contract
  if [[ "$had_previous_runtime" = true ]]; then
    if ! run_deploy; then
      echo "이전 Pull-it $component runtime 재기동도 실패했습니다. 즉시 운영자 점검이 필요합니다." >&2
    fi
  fi
  exit 1
fi

ln -sfn "$release" "$destination/.current-next"
mv -Tf "$destination/.current-next" "$destination/current"
echo "Pull-it $component revision $revision 배포를 확정했습니다."
